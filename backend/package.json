{
  "name": "codequest-2026-backend",
  "version": "0.1.0",
  "description": "CodeQuest-2026 backend (NestJS + TypeORM + PostgreSQL)",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "catalog:sync": "ts-node -T src/modules/catalog-scraper/cli/sync-catalog.cli.ts",
    "diag:listings": "ts-node -T src/modules/catalog-diagnostics/cli/diagnose-listings.cli.ts",
    "diag:investigate": "ts-node -T src/modules/catalog-diagnostics/cli/investigate.cli.ts",
    "diag:dry-run": "ts-node -T src/modules/catalog-diagnostics/cli/dry-run.cli.ts",
    "typeorm": "typeorm-ts-node-commonjs -d src/config/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.5",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/typeorm": "^11.0.3",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "mcp-oauth-server": "1.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.4",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.7",
    "embedded-postgres": "^18.4.0-beta.17",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "@embedded-postgres/linux-x64@18.4.0-beta.17": true
  }
}
