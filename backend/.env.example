# App
NODE_ENV=development
PORT=3000

# PostgreSQL (TypeORM)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=codequest
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Redis (catalog cache/locks) — local: 6379; Dokploy external: host IP + externalPort
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=

# Catalog scraper (DevTalles)
CATALOG_CRON_MODE=platform
CATALOG_CRON_SCHEDULE=0 6 * * *
CATALOG_CRON_IN_PROCESS=false
CATALOG_LOCK_TTL_MS=1800000
CATALOG_LOCK_KEY=catalog:lock
CATALOG_SYNC_TOKEN=change-me

# Auth Discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Local: http://localhost:3000/... — Dokploy:
# https://codequest-backend-zhydji-2dfcea-31-97-78-167.sslip.io/api/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
SESSION_JWT_SECRET=dev-only-change-me-32chars-minimum!!
FRONTEND_URL=http://localhost:3000
SESSION_TTL_DAYS=7
OAUTH_STATE_TTL_SECONDS=600
SESSION_COOKIE_NAME=cq_session
# SESSION_COOKIE_SECURE defaults to true in production, false otherwise
# Cross-origin browser → API needs none + secure
SESSION_COOKIE_SAMESITE=lax

# Cloudinary (avatar uploads). Empty until configured; upload then returns 503.
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_BASE_FOLDER=CodeQuest

